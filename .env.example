# API key for manual/auto summaries (OpenAI SDK). Leave blank for heuristic summaries.
OPENAI_API_KEY=

# Summaries budget and behavior
SUMMARY_DAILY_CAP_USD=1.00
SUMMARY_MAX_ITEMS=12
SUMMARY_AUTO=false

# Optional Reddit creds (HotNow/StudyNext improve with Reddit)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=researcherbrief/1.0 (by you)

# CORS for local web dev
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# SQLite db path (mounted via ./data volume)
BRIEF_DB_PATH=data/brief.db

# Windows for hot topics and study-next
HOT_WINDOW_DAYS=3
HOT_BUCKET_HOURS=6
STUDY_WINDOW_DAYS=21
